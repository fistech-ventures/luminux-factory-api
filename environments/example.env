PORT=$PORT
APP_IDENTIFIER=$APP_IDENTIFIER
APP_TITLE=$APP_TITLE
NODE_ENV=$NODE_ENV
API_PREFIX=api/v1
TZ=UTC
TIME_ZONE=Asia/Dhaka

# 
# Swagger
# 

API_VERSION=1.0.0
API_TITLE=$API_TITLE
API_DESCRIPTION=$API_DESCRIPTION

# 
# Default DB
# 

DB_TYPE=postgres
DB_HOST=$DB_HOST
DB_PORT=5432
DB_USERNAME=$DB_USERNAME
DB_PASSWORD=$DB_PASSWORD
DB_DATABASE=$DB_DATABASE
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSLMODE=false
DB_REJECT_UNAUTHORIZED=false

# 
# Security
# 

CORS_ALLOWED_ORIGINS=$CORS_ALLOWED_ORIGINS
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# 
# Logger
# 

LOG_FOLDER=logs

# 
# JWT
# 

JWT_SECRET=$JWT_SECRET
JWT_SALT_ROUNDS=10
JWT_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

