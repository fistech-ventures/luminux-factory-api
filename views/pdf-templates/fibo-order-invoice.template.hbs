<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Fibonacci Bookshop Invoice - {{invoiceCode}}</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Baloo+Da+2:wght@400..800&display=swap'
      rel='stylesheet'
    />
    <style>
      body {
        font-family: 'Baloo Da 2', Arial, sans-serif;
      }
    </style>
  </head>
  <body>
    <div style='margin: 0 auto'>
      <div
        style='
          background-color: white;
          /* box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); */
          border: 1px solid #e5e7eb;
          border-radius: .5rem;
          padding: 1rem;
          max-width: 38rem;
          margin: 0 auto;
        '
      >
        <!-- Header -->
        <div
          style='
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
          '
        >
          <div>
            <img
              src='https://fibonaccibookshop.com/images/fibonacci-logo.svg'
              alt='Fibonacci Bookshop'
              style='height: 50px'
            />
            <p style='font-size: 0.875rem; color: #6b7280; margin: 0.25rem 0 0 0'>
              Invoice:
              <span id='invoiceCode'>{{invoiceCode}}</span>
            </p>
          </div>
          <div>
            <span
              id='paymentStatus'
              style='
                padding: 0.25rem 1rem;
                border-radius: 9999px;
                font-size: 0.875rem;
                font-weight: 600;
                background-color: #dcfce7;
                color: #16a34a;
              '
            >{{paymentStatus}}</span>
          </div>
        </div>

        <!-- Customer Info -->
        <div style='margin-bottom: 1.5rem'>
          <h2 style='font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; color: #374151'>
            Customer Information
          </h2>
          <p
            style='color: #374151; font-weight: 500; margin: 0'
            id='customerName'
          >{{customerName}}</p>
          <p style='color: #6b7280; margin: 0' id='customerPhone'>{{customerPhone}}</p>
          <p style='color: #6b7280; margin: 0' id='customerAddress'>{{customerAddress}}</p>
        </div>

        <!-- Order Info -->
        <div
          style='
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
          '
        >
          <div>
            <p style='color: #6b7280; margin: 0'>Order Code</p>
            <p style='font-weight: 500; margin: 0' id='orderCode'>{{orderCode}}</p>
          </div>
          <div>
            <p style='color: #6b7280; margin: 0'>Date</p>
            <p style='font-weight: 500; margin: 0' id='orderDate'>{{date}}</p>
          </div>
          <div>
            <p style='color: #6b7280; margin: 0'>Payment Method</p>
            <p style='font-weight: 500; margin: 0' id='paymentMethod'>{{paymentMethod}}</p>
          </div>
          <div>
            <p style='color: #6b7280; margin: 0'>Order Status</p>
            <p style='font-weight: 500; margin: 0' id='orderStatus'>CONFIRMED</p>
          </div>
        </div>

        <!-- Items Table -->
        <div style='overflow-x: auto; margin-bottom: 1.5rem'>
          <table
            style='
              width: 100%;
              border: 1px solid #e5e7eb;
              border-radius: 0.5rem;
              overflow: hidden;
              font-size: 0.875rem;
              border-collapse: collapse;
            '
          >
            <thead style='background-color: #ff6f61; color: white'>
              <tr>
                <th style='text-align: left; padding: 0.75rem'>Book</th>
                <th style='padding: 0.75rem'>Author</th>
                <th style='padding: 0.75rem'>Publication</th>
                <th style='padding: 0.75rem'>Price</th>
                <th style='padding: 0.75rem'>Qty</th>
                <th style='padding: 0.75rem'>Total</th>
              </tr>
            </thead>
            <tbody id='itemsTableBody'>
              {{#each products}}
                <tr style='border-top: 1px solid #e5e7eb'>
                  <td
                    style='display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; min-width: 200px'
                  >
                    <img
                      src={{this.product.thumb}}
                      alt='Book'
                      style='width: 50px; height: 70px; border-radius: 0.25rem'
                    />
                    <span>{{this.product.title}}</span>
                  </td>
                  <td
                    style='text-align: center; padding: 0.75rem; min-width: 100px'
                  >{{this.product.author.name}}</td>
                  <td
                    style='text-align: center; padding: 0.75rem'
                  >{{this.product.publication.name}}</td>
                  <td style='text-align: center; padding: 0.75rem'>
                    {{!-- <del>৳{{this.product.mrp}}</del>
                    ৳{{this.product.saleAmount}}</td> --}}
                    ৳{{this.product.mrp}}</td>
                  <td style='text-align: center; padding: 0.75rem'>{{this.quantity}}</td>
                  <td style='text-align: center; padding: 0.75rem'>৳{{arithmetic
                      this.product.mrp
                      '*'
                      this.quantity
                    }}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <!-- Customer Instruction + Summary Wrapper -->
        <div
          style='
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 1rem;
  '
        >

          <!-- Customer Instruction -->
          <div
            style='
      flex: 1;
      font-size: 0.875rem;
      color: #374151;
      line-height: 1.5;
      word-break: break-word;
    '
          >
            <p style='font-weight: 600; margin-bottom: 0.25rem;'>Customer Instruction</p>
            <p style='margin: 0;'>{{customerInstruction}}</p>
          </div>

          <!-- Summary -->
          <div
            style='
      width: 100%;
      max-width: 21.333333rem;
      background-color: #f9fafb;
      border-radius: 0.75rem;
      padding: 1rem;
      font-size: 0.875rem;
      flex-shrink: 0;
    '
          >
            <div style='display: flex; justify-content: space-between; margin-bottom: 0.5rem'>
              <span>Subtotal</span>
              <span id='subtotal'>৳{{subTotal}}</span>
            </div>
            <div style='display: flex; justify-content: space-between; margin-bottom: 0.5rem'>
              <span>Discount</span>
              <span id='discount'>৳{{discountAmount}}</span>
            </div>
            <div style='display: flex; justify-content: space-between; margin-bottom: 0.5rem'>
              <span>Delivery Charge</span>
              <span id='deliveryCharge'>৳{{deliveryCharge}}</span>
            </div>
            <div style='display: flex; justify-content: space-between; margin-bottom: 0.5rem'>
              <span>Total</span>
              <span id='total'>৳{{total}}</span>
            </div>
            <div
              style='display: flex; justify-content: space-between; color: #dc2626; margin-bottom: 0.5rem'
            >
              <span>Due</span>
              <span id='due'>৳{{dueAmount}}</span>
            </div>
            <div
              style='
        border-top: 1px solid #e5e7eb;
        margin-top: 0.5rem;
        padding-top: 0.5rem;
        display: flex;
        justify-content: space-between;
        font-weight: 600;
      '
            >
              <span>Grand Total</span>
              <span id='grandTotal'>৳{{payableAmount}}</span>
            </div>
          </div>

        </div>

        <!-- Footer -->
        <div
          style='
            border-top: 1px solid #e5e7eb;
            margin-top: 1.5rem;
            padding-top: 0.75rem;
            text-align: center;
            font-size: 0.75rem;
            color: #6b7280;
          '
        >
          <div>
            <a
              href='https://fibonaccibookshop.com'
              target='_blank'
              style='color: #d90505; text-decoration: none; font-weight: 500;'
            >
              ফিবোনাক্কি : Book & Such ( www.fibonaccibookshop.com )
            </a>
          </div>

          <div style='margin-top: 0.25rem;'>
            Powered by
            <a
              href='https://pitech.com.bd'
              target='_blank'
              style='color: #2563eb; text-decoration: none; font-weight: 500;'
            >
              Progressive Information Technology
            </a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>