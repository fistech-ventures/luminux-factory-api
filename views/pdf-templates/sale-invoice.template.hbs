<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice {{invoiceCode}}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial,
          sans-serif;
        color: #1f2937;
        font-size: 13px;
        line-height: 1.5;
      }
      .page {
        max-width: 720px;
        margin: 0 auto;
        padding: 28px;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 3px solid #4f46e5;
        padding-bottom: 18px;
      }
      .business {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .business img {
        max-height: 56px;
        max-width: 120px;
        object-fit: contain;
      }
      .business-name {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
      }
      .business-meta {
        color: #6b7280;
        font-size: 12px;
        margin-top: 2px;
      }
      .doc-title {
        text-align: right;
      }
      .doc-title h1 {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: 2px;
        color: #4f46e5;
        text-transform: uppercase;
      }
      .badge {
        display: inline-block;
        margin-top: 6px;
        padding: 3px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
      }
      .badge-paid { background-color: #16a34a; }
      .badge-partial { background-color: #d97706; }
      .badge-due { background-color: #dc2626; }
      .meta-grid {
        display: flex;
        gap: 24px;
        margin-top: 16px;
        font-size: 12px;
      }
      .meta-grid .label { color: #6b7280; }
      .meta-grid .value { font-weight: 600; color: #111827; }
      .parties {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        margin: 22px 0;
      }
      .party { flex: 1; }
      .party h3 {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #6b7280;
        margin-bottom: 6px;
      }
      .party .name { font-weight: 700; font-size: 14px; }
      .party .detail { color: #4b5563; font-size: 12px; }
      table.items {
        width: 100%;
        border-collapse: collapse;
        margin-top: 6px;
      }
      table.items thead th {
        background-color: #4f46e5;
        color: #fff;
        text-align: left;
        padding: 9px 10px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      table.items thead th.num, table.items tbody td.num { text-align: right; }
      table.items tbody td {
        padding: 9px 10px;
        border-bottom: 1px solid #e5e7eb;
        vertical-align: top;
      }
      .item-title { font-weight: 600; }
      .item-variant { color: #6b7280; font-size: 11px; }
      .summary {
        display: flex;
        justify-content: flex-end;
        margin-top: 18px;
      }
      .summary-box {
        width: 320px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
      }
      .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 14px;
        font-size: 13px;
      }
      .summary-row.total {
        background-color: #4f46e5;
        color: #fff;
        font-weight: 700;
        font-size: 15px;
      }
      .summary-row.due { color: #dc2626; font-weight: 600; }
      .amount-words {
        margin-top: 14px;
        font-size: 12px;
        color: #374151;
      }
      .amount-words .label { color: #6b7280; }
      .amount-words .value { font-weight: 600; }
      .footer {
        margin-top: 26px;
        padding-top: 14px;
        border-top: 1px solid #e5e7eb;
        text-align: center;
        font-size: 11px;
        color: #9ca3af;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <!-- Header -->
      <div class="header">
        <div class="business">
          {{#if business.logo}}
            <img src="{{business.logo}}" alt="Logo" />
          {{/if}}
          <div>
            <div class="business-name">{{business.name}}</div>
            <div class="business-meta">
              {{#if business.address}}{{business.address}}<br />{{/if}}
              {{#if business.phone}}Phone: {{business.phone}}{{/if}}
            </div>
          </div>
        </div>
        <div class="doc-title">
          <h1>Invoice</h1>
          <div style="color: #4b5563; font-weight: 600">{{invoiceCode}}</div>
          {{#compare paymentStatus 'PAID' '==='}}
            <span class="badge badge-paid">PAID</span>
          {{else}}
            {{#compare paymentStatus 'PARTIAL' '==='}}
              <span class="badge badge-partial">PARTIAL</span>
            {{else}}
              <span class="badge badge-due">DUE</span>
            {{/compare}}
          {{/compare}}
        </div>
      </div>

      <!-- Meta: date / payment method / sold by -->
      <div class="meta-grid">
        <div>
          <div class="label">Date</div>
          <div class="value">{{date}}</div>
        </div>
        <div>
          <div class="label">Payment Method</div>
          <div class="value">{{paymentMethod}}</div>
        </div>
        <div>
          <div class="label">Sold By</div>
          <div class="value">{{soldByName}}</div>
        </div>
      </div>

      <!-- Parties -->
      <div class="parties">
        <div class="party">
          <h3>Billed From</h3>
          <div class="name">{{business.name}}</div>
          <div class="detail">
            {{#if business.address}}{{business.address}}<br />{{/if}}
            {{#if business.phone}}Phone: {{business.phone}}{{/if}}
          </div>
        </div>
        <div class="party" style="text-align: right">
          <h3>Billed To</h3>
          <div class="name">{{customerName}}</div>
          <div class="detail">
            {{#if customerCompany}}{{customerCompany}}<br />{{/if}}
            {{#if customerPhone}}Phone: {{customerPhone}}<br />{{/if}}
            {{#if customerAddress}}{{customerAddress}}{{/if}}
          </div>
        </div>
      </div>

      <!-- Items -->
      <table class="items">
        <thead>
          <tr>
            <th style="width: 40px">#</th>
            <th>Item</th>
            <th class="num" style="width: 70px">Qty</th>
            <th class="num" style="width: 100px">Unit Price</th>
            <th class="num" style="width: 110px">Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
            <tr>
              <td>{{addOne @index}}</td>
              <td>
                <div class="item-title">{{this.title}}</div>
                {{#if this.variantLabel}}
                  <div class="item-variant">{{this.variantLabel}}</div>
                {{/if}}
              </td>
              <td class="num">{{this.quantity}}</td>
              <td class="num">{{business.currency}}{{this.unitPrice}}</td>
              <td class="num">{{business.currency}}{{this.total}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>

      <!-- Summary -->
      <div class="summary">
        <div class="summary-box">
          <div class="summary-row">
            <span>Subtotal</span>
            <span>{{business.currency}}{{subTotal}}</span>
          </div>
          <div class="summary-row">
            <span>Discount</span>
            <span>{{business.currency}}{{discount}}</span>
          </div>
          <div class="summary-row">
            <span>Paid</span>
            <span>{{business.currency}}{{paidAmount}}</span>
          </div>
          {{#compare dueAmount 0 '>'}}
            <div class="summary-row due">
              <span>Due</span>
              <span>{{business.currency}}{{dueAmount}}</span>
            </div>
          {{/compare}}
          <div class="summary-row total">
            <span>Grand Total</span>
            <span>{{business.currency}}{{grandTotal}}</span>
          </div>
        </div>
      </div>

      <!-- Amount in words -->
      <div class="amount-words">
        <span class="label">Amount in words: </span>
        <span class="value">{{convertAmountToWords grandTotal currencyName}}</span>
      </div>

      <!-- Footer -->
      <div class="footer">
        {{#if business.name}}{{business.name}} — Thank you for your business!{{else}}Thank you for your business!{{/if}}
      </div>
    </div>
  </body>
</html>