<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice {{invoiceCode}}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Arial', 'Helvetica', sans-serif;
      color: #000;
      font-size: 12px;
      line-height: 1.4;
      background: #fff;
      margin: 0;
      padding: 0;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 0;
      position: relative;
      background: #fff;
    }

    .header-image {
      width: 100%;
      height: auto;
      margin-bottom: 20px;
    }

    .invoice-content {
      padding: 0 20px;
    }

    .invoice-title {
      font-size: 32px;
      font-weight: bold;
      color: #000;
      margin-bottom: 20px;
      text-align: center;
      text-decoration: underline;
    }

    .invoice-meta {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: #333;
      margin-bottom: 20px;
      border-bottom: 1px solid #000;
    }

    .invoice-meta .left {
      text-align: left;
    }

    .invoice-meta .right {
      text-align: right;
    }

    .invoice-meta .label {
      font-weight: bold;
      color: #000;
      display: inline-block;
    }

    .invoice-meta .value {
      color: #000;
    }

    .parties {
      display: flex;
      justify-content: space-between;
      gap: 40px;
      margin: 25px 0;
    }

    .party {
      flex: 1;
    }

    .party h3 {
      font-size: 12px;
      font-weight: bold;
      color: #000;
      border-bottom: 1px solid #000;
      padding-bottom: 4px;
      margin-bottom: 8px;
      text-transform: uppercase;
    }

    .party .name {
      font-weight: bold;
      font-size: 13px;
      margin-bottom: 4px;
    }

    .party .detail {
      color: #000;
      font-size: 12px;
      line-height: 1.4;
    }

    table.items {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    table.items thead th {
      background-color: #2B4837;
      color: #fff;
      text-align: center;
      padding: 5px 5px;
      font-size: 14px;
      font-weight: bold;
      border: 1px solid #000;
    }

    table.items thead th.num,
    table.items tbody td.num {
      text-align: right;
    }

    table.items tbody td {
      padding: 5px 5px;
      border: 1px solid #000;
      vertical-align: top;
      font-size: 12px;
    }

    .item-title {
      font-weight: bold;
    }

    .item-variant {
      color: #666;
      font-size: 10px;
      margin-top: 2px;
    }

    .summary {
      display: flex;
      justify-content: flex-end;
      margin-top: 20px;
    }

    .summary-box {
      width: 220px;
      border: 1px solid #000;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 5px 5px;
      font-size: 12px;
      border-bottom: 1px solid #ddd;
    }

    .summary-row:last-child {
      border-bottom: none;
    }

    .summary-row.total {
      background-color: #e8e8e8;
      font-weight: bold;
      font-size: 12px;
      border-top: 2px solid #000;
    }

    .summary-row.due {
      color: #dc2626;
      font-weight: bold;
    }

    .footer-section {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
    }

    .signature-section {
      padding: 0 20px;
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
    }

    .signature-box {
      width: 200px;
      text-align: center;
    }

    .signature-line {
      border-top: 1px solid #000;
      margin-top: 40px;
      padding-top: 5px;
      font-size: 12px;
      font-weight: bold;
    }

    .footer-image {
      width: 100%;
      height: auto;
      object-fit: cover;
    }
  </style>
</head>

<body>
  <div class="page">
    <!-- Header Image -->
    <div class="header-image">
      {{#if headerImage}}
      <img src="{{headerImage}}" alt="Header" style="width: 100%; height: auto;" />
      {{/if}}
    </div>

    <!-- Watermark Image -->
    {{#if watermarkImage}}
    <img src="{{watermarkImage}}" alt="Watermark"
      style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.7; width: 500px; height: auto;" />
    {{/if}}

    <div class="invoice-content">
      <!-- Invoice Title -->
      <div class="invoice-title">INVOICE</div>

      <!-- Invoice Meta -->
      <div class="invoice-meta">
        <div class="left">
          <div><span class="label">DATE:</span> <span class="value">{{date}}</span></div>
        </div>
        <div class="right">
          <div><span class="label">INVOICE NO:</span> <span class="value">{{invoiceCode}}</span></div>
        </div>
      </div>

      <!-- Parties -->
      <div class="parties">
        <div class="party">
          <h3>Bill To</h3>
          <div class="name">
            {{#if customerCompany}}
            {{customerCompany}}
            {{else}}
            {{customerName}}
            {{/if}}
          </div>
          <div class="detail">
            {{#if customerPhone}}Phone: {{customerPhone}}<br />{{/if}}
            {{#if customerAddress}}{{customerAddress}}{{/if}}
          </div>
        </div>
        <div class="party" style="text-align: right">
          <h3>Ship To</h3>
          <div class="name">{{shippingTo}}</div>
          <div class="detail">
            {{#if shippingContact}}Phone: {{shippingContact}}<br />{{/if}}
            {{#if shippingAddress}}{{shippingAddress}}{{/if}}
          </div>
        </div>
      </div>

      <!-- Items -->
      <table class="items">
        <thead>
          <tr>
            <th style="width: 50px">SL</th>
            <th>DESCRIPTION</th>
            <th class="num" style="width: 80px">QNTY</th>
            <th class="num" style="width: 100px">UNIT PRICE</th>
            <th class="num" style="width: 100px">TOTAL</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
          <tr>
            <td>{{addOne @index}}</td>
            <td>
              <div class="item-title">{{this.title}}</div>
              {{#if this.variantLabel}}
              <div class="item-variant">{{this.variantLabel}}</div>
              {{/if}}
            </td>
            <td class="num">{{this.quantity}}{{#if this.unit}} {{this.unit}}{{/if}}</td>
            <td class="num">{{business.currency}}{{this.unitPrice}}</td>
            <td class="num">{{business.currency}}{{this.total}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <!-- Summary -->
      <div class="summary">
        <div class="summary-box">
          <div class="summary-row">
            <span>Total Amount</span>
            <span>{{subTotal}}</span>
          </div>
          <div class="summary-row">
            <span>Discount</span>
            <span>{{discount}}</span>
          </div>
          <div class="summary-row">
            <span>Grand Total</span>
            <span>{{grandTotal}}</span>
          </div>
          <div class="summary-row">
            <span>Paid Amount</span>
            <span>{{paidAmount}}</span>
          </div>
          {{#compare dueAmount 0 '>'}}
          <div class="summary-row due">
            <span>Due Amount</span>
            <span>{{dueAmount}}</span>
          </div>
          {{/compare}}
        </div>
      </div>
    </div>

    <!-- Footer Section -->
    <div class="footer-section">
      <!-- Signature Section -->
      <div class="signature-section">
        <div class="signature-box">
          <div class="signature-line">Received By</div>
        </div>
        <div class="signature-box">
          <div class="signature-line">Prepared By</div>
        </div>
      </div>
      <!-- Footer Image -->
      <div class="footer-image">
        {{#if footerImage}}
        <img src="{{footerImage}}" alt="Footer" style="width: 100%; height: auto;" />
        {{/if}}
      </div>
    </div>
  </div>
</body>

</html>